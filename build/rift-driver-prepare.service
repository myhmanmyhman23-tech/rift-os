[Unit]
Description=RIFT OS first-boot graphics preparation
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/var/lib/rift-os/drivers-ready

[Service]
Type=oneshot
ExecStart=/bin/bash /usr/share/rift-os/first-boot.sh
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
